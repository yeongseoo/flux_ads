# ── 사이트 기본 정보 ─────────────────────────────
# 실제 서비스 도메인 (SEO, Open Graph, sitemap에 사용)
SITE_URL=https://example.com

# 공식 문의 이메일 (설정된 경우에만 사이트에 표시됩니다)
CONTACT_EMAIL=

# 회사 정보 (확정된 정보만 입력하세요. 비워 두면 사이트에 표시되지 않습니다)
COMPANY_NAME=
COMPANY_REPRESENTATIVE=
COMPANY_BUSINESS_NUMBER=
COMPANY_ADDRESS=
# 개인정보 보호책임자 (비워 두면 'FLUX ADS 운영팀'으로 표시)
PRIVACY_OFFICER=

# ── 데이터베이스 ────────────────────────────────
# SQLite 파일 경로 (기본값: ./data/flux-ads.db)
DATABASE_PATH=./data/flux-ads.db

# ── 관리자 인증 ─────────────────────────────────
ADMIN_USERNAME=admin
# npm run admin:hash -- '강력한비밀번호'  로 생성한 값을 붙여 넣으세요
ADMIN_PASSWORD_HASH=
# npm run secret 으로 생성한 32자 이상의 임의 문자열
SESSION_SECRET=
